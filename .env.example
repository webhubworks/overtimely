TIMELY_API_URL=https://api.timelyapp.com/1.1/
TIMELY_API_TIMEOUT=15

# OAuth application credentials (create an app in your Timely account under oauth_applications).
# TIMELY_OAUTH_REDIRECT_URI must match the redirect registered on that app.
# The standard out-of-band value is prefilled below.
TIMELY_OAUTH_CLIENT_ID=
TIMELY_OAUTH_CLIENT_SECRET=
TIMELY_OAUTH_REDIRECT_URI=urn:ietf:wg:oauth:2.0:oob

# Advanced (self-hosted / regional Timely): override the OAuth endpoints.
# TIMELY_OAUTH_AUTHORIZE_URL=
# TIMELY_OAUTH_TOKEN_URL=

# Obtained automatically by `auth:login` and stored in the config file.
# You normally do not set these by hand.
TIMELY_TOKENS_ACCESS=
TIMELY_TOKENS_REFRESH=
TIMELY_TOKENS_EXPIRES_AT=

# Your Timely workspace ID. TIMELY_USER_ID and TIMELY_USER_CREATED_AT are filled automatically by `auth:whoami`.
TIMELY_ACCOUNT_ID=
TIMELY_USER_ID=

# Creation date of your Timely user. Used as the fallback start date for the report period (Should be ISO 8601 format: YYYY-MM-DD)
# Precedence: -s/--since command option -> TIMELY_REPORT_SINCE -> TIMELY_USER_CREATED_AT
TIMELY_USER_CREATED_AT=

# Custom default start date for the report period (Supported formats: https://www.php.net/manual/en/datetime.formats.php)
# Precedence: -s/--since command option -> TIMELY_REPORT_SINCE -> TIMELY_USER_CREATED_AT
TIMELY_REPORT_SINCE=

# Possible table styles:
# default, compact, markdown, borderless, symfony-style-guide, box, box-double
DISPLAY_TABLE_STYLE=
